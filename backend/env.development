# Backend Development Environment Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=debug
ENABLE_LOGGING=true
# Use the Docker service name for internal communication
POCKETBASE_URL=http://pocketbase:8090
# Use localhost for the public-facing URL for OAuth redirects
POCKETBASE_PUBLIC_URL=http://localhost:8090
API_VERSION=v1
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3001
SESSION_SECRET=your-super-secret-session-key-change-in-production-12345